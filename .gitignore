cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual env
venv/
.venv/
env/

# Env files
.env
.env.local
.env.*.local

# Node
node_modules/
dist/
build/
.vite/

# IDE
.idea/
.vscode/
.DS_Store

# Logs
*.log

# Docker/Postgres local
postgres_data/
EOF